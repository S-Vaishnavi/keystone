# Copy this file's values into your own environment (Eclipse Run Config,
# or `set VAR=value` in terminal) — DO NOT commit a real .env file.

# Your local PostgreSQL credentials for the keystone_dev database
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password

# Used to sign JWTs locally - any long random string works for dev
JWT_SECRET=dev-secret-change-me-please-make-this-long-enough-for-hs256
